# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma
/prisma/*.db
/prisma/*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# uploaded media
/public/uploads
/uploads

# Capacitor / Android local
/android/local.properties
/android/.gradle
/android/app/build
/android/build
/android/captures
/android/.idea
/android/app/release
*.apk
*.jks
*.keystore

# Electron Windows client local build
/desktop/node_modules
/desktop/dist
/desktop/*.exe
# 站点下载包保留在 public/app，由构建脚本生成；本地大文件可不提交
/public/app/*.exe
/public/app/*.zip
/public/app/*.apk
