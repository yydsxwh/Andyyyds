AUTH_SECRET="change-me"
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_SITE_URL="https://www.yydsxwh.com"

# mock | wechat（配齐微信参数后可不写，会自动启用 wechat）
PAYMENT_MODE="wechat"

# 微信支付商户（Native 扫码 / JSAPI / H5）
# AppID 需与商户号绑定；微信内 JSAPI 还需公众号 AppSecret + 网页授权域名
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
WECHAT_MCH_ID=""
WECHAT_API_V3_KEY=""
WECHAT_MCH_SERIAL_NO=""
# 私钥二选一：文件路径，或把 PEM 整段写入（换行写成 \n）
WECHAT_MCH_PRIVATE_KEY_PATH="/var/www/yyds-course-platform/certs/apiclient_key.pem"
# WECHAT_MCH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 微信开放平台「网站应用」扫码登录（PC / 站外浏览器）
# 与上方公众号 AppID 不同；也可在后台「系统设置 → 微信扫码登录」填写，无需写进 .env
# 开放平台授权回调域填：www.yydsxwh.com（不要带 https:// 与路径）
WECHAT_WEB_APP_ID=""
WECHAT_WEB_APP_SECRET=""

# ---- 公共平台（platform）----
# 只放占位符；真实凭证从运维环境注入，不得提交进 Git。
# PLATFORM_SERVICE_TOKEN 是服务端密钥，绝不能出现在浏览器或 App 里。
# 必须与 softwarelist / 未来 rishi 使用不同的 token。
# 预发联调用 https://api-staging.yydsxwh.com ；未部署前留空。不要填生产域名做预发。
PLATFORM_API_URL=""
PLATFORM_SERVICE_TOKEN=""
PLATFORM_CLIENT_ID="andyyyds"
# 存储切到 platform：留空或非 true 时行为与迁移前完全一致
PLATFORM_STORAGE_ENABLED="false"
# 产品目录与安装包下载切到 platform：同样默认关闭
PLATFORM_CATALOG_ENABLED="false"
PLATFORM_RELEASES_ENABLED="false"
# AI 切到 platform：留空或非 true 时仍用本机「AI 接口」配置
PLATFORM_AI_ENABLED="false"
