AUTH_SECRET="change-me"
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 统一账号中心 OIDC（主站是 Client，不共享 AUTH_SECRET / 数据库）
# ACCOUNT_ISSUER="https://account.yydsxwh.com"
# ACCOUNT_CLIENT_ID="www"
# ACCOUNT_CLIENT_SECRET=""
# ACCOUNT_REDIRECT_URI="https://www.yydsxwh.com/api/auth/callback"
# ACCOUNT_SCOPES="openid profile email phone account.basic"

# mock | wechat（配齐微信参数后可不写，会自动启用 wechat）
PAYMENT_MODE="wechat"

# 微信支付商户（Native 扫码 / JSAPI / H5）
# AppID 需与商户号绑定；微信内 JSAPI 还需公众号 AppSecret + 网页授权域名
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
WECHAT_MCH_ID=""
WECHAT_API_V3_KEY=""
WECHAT_MCH_SERIAL_NO=""
# 私钥二选一：文件路径，或把 PEM 整段写入（换行写成 \n）
WECHAT_MCH_PRIVATE_KEY_PATH="certs/apiclient_key.pem"
# WECHAT_MCH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 微信开放平台「网站应用」扫码登录（PC / 站外浏览器）
# 与上方公众号 AppID 不同；也可在后台「系统设置 → 微信扫码登录」填写，无需写进 .env
# 开放平台授权回调域填：www.yydsxwh.com（不要带 https:// 与路径）
WECHAT_WEB_APP_ID=""
WECHAT_WEB_APP_SECRET=""
