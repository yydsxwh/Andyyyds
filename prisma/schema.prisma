generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  name         String
  bio          String             @default("")
  avatarUrl    String             @default("")
  role         String             @default("STUDENT")
  referralCode String             @unique
  referredById String?
  referredBy   User?              @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]             @relation("Referrals")
  courses              Course[]           @relation("TeacherCourses")
  enrollments          Enrollment[]
  orders               Order[]
  coupons              CouponRedemption[]
  mediaCategories      MediaCategory[]
  mediaAssets          MediaAsset[]
  commissionsEarned    Commission[]       @relation("CommissionBeneficiary")
  commissionsAsBuyer   Commission[]       @relation("CommissionBuyer")
  merchant             Merchant?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Merchant {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName     String
  contactName   String    @default("")
  contactPhone  String    @default("")
  contactWechat String    @default("")
  joinType      String    @default("DIRECT")
  status        String    @default("PENDING")
  notes         String    @default("")
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([joinType])
}

model DistributionConfig {
  id            String   @id @default("default")
  enabled       Boolean  @default(true)
  level1Percent Int      @default(20)
  level2Percent Int      @default(10)
  level3Percent Int      @default(5)
  updatedAt     DateTime @updatedAt
}

/// 站长系统设置（支付 / 存储），单例 id = default
model SiteSettings {
  id String @id @default("default")

  siteUrl String @default("")

  /// mock | auto | wechat | alipay | both
  paymentMode   String  @default("auto")
  wechatEnabled Boolean @default(true)
  alipayEnabled Boolean @default(false)

  wechatAppId         String @default("")
  wechatMchId         String @default("")
  wechatApiV3Key      String @default("")
  wechatMchSerialNo   String @default("")
  wechatMchPrivateKey String @default("")

  alipayAppId      String @default("")
  alipayPrivateKey String @default("")
  alipayPublicKey  String @default("")
  /// sandbox | production
  alipayGateway    String @default("production")

  /// 其他文件（图片/附件）存储：LOCAL | ALIYUN_OSS
  storageProvider   String @default("LOCAL")
  ossRegion         String @default("")
  ossBucket         String @default("")
  ossAccessKeyId    String @default("")
  ossAccessKeySecret String @default("")
  ossEndpoint       String @default("")
  ossPublicBaseUrl  String @default("")
  ossPrefix         String @default("uploads")

  /// 课程视频存储：LOCAL | ALIYUN_VOD（与 OSS 可同时启用）
  videoStorageProvider String @default("LOCAL")
  vodRegionId          String @default("cn-shanghai")
  vodAccessKeyId       String @default("")
  vodAccessKeySecret   String @default("")
  /// 不转码模板组，常见值 VOD_NO_TRANSCODE
  vodTemplateGroupId   String @default("VOD_NO_TRANSCODE")
  /// 播放域名（选填，不含协议）
  vodPlayDomain        String @default("")

  /// 后台/表单文案配置（JSON），属轻量 CMS，不是店铺装修
  uiCopyJson String @default("")

  /// 下单信息采集字段配置（JSON）：商家自定义「所在学校」等表单项
  orderFormJson String @default("")

  /// 店铺 DIY 装修配置（JSON）：Logo、首页 Banner 等视觉门面
  decorateJson String @default("")

  /// 后台导航菜单配置（JSON）：顶部导航 + 课程中心子菜单的文案与链接
  studioNavJson String @default("")

  updatedAt DateTime @updatedAt
}

model Commission {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  beneficiaryId String
  beneficiary   User     @relation("CommissionBeneficiary", fields: [beneficiaryId], references: [id])
  buyerId       String
  buyer         User     @relation("CommissionBuyer", fields: [buyerId], references: [id])
  level         Int
  ratePercent   Int
  amount        Int
  status        String   @default("SETTLED")
  createdAt     DateTime @default(now())

  @@index([beneficiaryId])
  @@index([orderId])
}

model MediaCategory {
  id        String       @id @default(cuid())
  name      String
  ownerId   String
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assets    MediaAsset[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([ownerId, name])
}

model MediaAsset {
  id          String         @id @default(cuid())
  name        String
  description String         @default("")
  type        String         @default("VIDEO")
  fileUrl     String
  fileName    String         @default("")
  mimeType    String         @default("")
  sizeBytes   Int            @default(0)
  durationSec Int            @default(0)
  /// LOCAL | ALIYUN_OSS | ALIYUN_VOD | EXTERNAL
  storageProvider String     @default("LOCAL")
  /// 阿里云点播 VideoId
  vodVideoId  String         @default("")
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    MediaCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  lessons     Lesson[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  courses     Course[]
  createdAt   DateTime @default(now())
}

model Course {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  subtitle      String       @default("")
  description   String
  coverUrl      String       @default("")
  price         Int          @default(0)
  originalPrice Int          @default(0)
  status        String       @default("DRAFT")
  productType   String       @default("COURSE")
  isFree        Boolean      @default(false)
  studentCount  Int          @default(0)
  rating        Float        @default(5)
  teacherId     String
  teacher       User         @relation("TeacherCourses", fields: [teacherId], references: [id])
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id])
  chapters      Chapter[]
  enrollments   Enrollment[]
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Chapter {
  id        String   @id @default(cuid())
  title     String
  sortOrder Int      @default(0)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  createdAt DateTime @default(now())
}

model Lesson {
  id           String           @id @default(cuid())
  title        String
  sortOrder    Int              @default(0)
  type         String           @default("VIDEO")
  content      String           @default("")
  videoUrl     String           @default("")
  durationSec  Int              @default(0)
  isPreview    Boolean          @default(false)
  liveAt       DateTime?
  chapterId    String
  chapter      Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  mediaAssetId String?
  mediaAsset   MediaAsset?      @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  progress     LessonProgress[]
  createdAt    DateTime         @default(now())
}

model Enrollment {
  id        String           @id @default(cuid())
  userId    String
  courseId  String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  LessonProgress[]
  createdAt DateTime         @default(now())

  @@unique([userId, courseId])
}

model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  lessonId     String
  completed    Boolean    @default(false)
  positionSec  Int        @default(0)
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  updatedAt    DateTime   @updatedAt

  @@unique([enrollmentId, lessonId])
}

model Coupon {
  id            String             @id @default(cuid())
  code          String             @unique
  title         String
  discountCents Int
  minAmount     Int                @default(0)
  maxUses       Int                @default(100)
  usedCount     Int                @default(0)
  expiresAt     DateTime?
  isActive      Boolean            @default(true)
  redemptions   CouponRedemption[]
  orders        Order[]
  createdAt     DateTime           @default(now())
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
}

model Order {
  id              String       @id @default(cuid())
  orderNo         String       @unique
  userId          String
  courseId        String
  amount          Int
  discount        Int          @default(0)
  status          String       @default("PENDING")
  payChannel      String       @default("")
  providerTradeNo String       @default("")
  codeUrl         String       @default("")
  couponId        String?
  referralCode    String?
  /// 用户填写的下单信息采集答案（JSON）
  formAnswersJson String       @default("")
  paidAt          DateTime?
  user            User         @relation(fields: [userId], references: [id])
  course          Course       @relation(fields: [courseId], references: [id])
  coupon          Coupon?      @relation(fields: [couponId], references: [id])
  commissions     Commission[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}
