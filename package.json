{
  "name": "andyyyds",
  "version": "0.1.0",
  "private": true,
  "description": "Andyyyds 产品工作区：站点壳 + 公共包 + 按产品拆分的源码包",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:server": "node server/prod.mjs",
    "build": "prisma generate && next build --webpack",
    "start": "NODE_ENV=production node server/prod.mjs",
    "start:next": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "app:sync": "npx cap sync android",
    "app:open": "npx cap open android",
    "app:build": "npx cap sync android && node scripts/build-android-apk.mjs",
    "app:build:windows": "node scripts/build-windows-client.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@alicloud/pop-core": "^1.8.0",
    "@andyyyds/company": "*",
    "@andyyyds/courses": "*",
    "@andyyyds/docs": "*",
    "@andyyyds/forum": "*",
    "@andyyyds/mathcode": "*",
    "@andyyyds/meetup": "*",
    "@andyyyds/person": "*",
    "@andyyyds/shared": "*",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "geo-tz": "^8.1.8",
    "jose": "^6.2.8",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "mammoth": "^1.12.2",
    "next": "16.3.0",
    "opencc-js": "^1.4.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.8",
    "typescript": "^5"
  }
}
