{
  "name": "yyds-windows-client",
  "version": "1.2.0",
  "private": true,
  "description": "歪歪滴艾斯 Windows 客户端：网易云风格桌面壳 + 官网完整功能",
  "main": "main.cjs",
  "author": "YYDS",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.yydsxwh.app",
    "productName": "歪歪滴艾斯",
    "copyright": "Copyright © YYDS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload-shell.cjs",
      "preload-view.cjs",
      "preload.cjs",
      "icon.png",
      "shell/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "歪歪滴艾斯",
      "installerLanguages": ["zh_CN", "en_US"],
      "language": "2052",
      "artifactName": "yyds-windows-setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "yyds-windows.exe"
    },
    "asar": true
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  }
}
